// CHECK-LABEL:   handshake.func @cmergeToMuxIndexOpt(
// CHECK-SAME:     %[[VAL_0:.*]]: <i32>, %[[VAL_1:.*]]: <i32>, %[[VAL_2:.*]]: <>) -> (out0: <i32>) {
// CHECK:           %[[VAL_3:.*]], %[[VAL_4:.*]] = control_merge {{\[}}%[[VAL_0]]]  : [<i32>] to <i32>, <i1>
// CHECK:           %[[VAL_5:.*]], %[[VAL_6:.*]] = control_merge {{\[}}%[[VAL_1]]]  : [<i32>] to <i32>, <i1>
// CHECK:           %[[VAL_7:.*]] = extui %[[VAL_6]] : <i1> to <i32>
// CHECK:           %[[VAL_8:.*]] = addi %[[VAL_5]], %[[VAL_7]] : <i32>
// CHECK:           %[[VAL_9:.*]] = addi %[[VAL_8]], %[[VAL_3]] : <i32>
// CHECK:           end %[[VAL_9]] : <i32>
// CHECK:         }
handshake.func @cmergeToMuxIndexOpt(%arg0: <i32>, %arg1: <i32>, %start: <>) -> (<i32>) {
  %result, %index = control_merge [%arg0] : [<i32>] to <i32>, <i32>
  %mux = mux %index [%arg1] : <i32>, [<i32>] to <i32>
  %otherResult, %otherIndex = control_merge [%arg1] : [<i32>] to <i32>, <i32>
  %add1 = addi %otherResult, %otherIndex : <i32>
  %add2 = addi %add1, %result : <i32>
  end %add2 : <i32>
}


