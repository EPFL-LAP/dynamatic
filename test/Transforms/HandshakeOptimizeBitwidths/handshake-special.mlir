// CHECK-LABEL:   handshake.func @cmergeToMuxIndexOpt(
// CHECK-SAME:     %[[VAL_0:.*]]: <i32>, %[[VAL_1:.*]]: <i32>, %[[VAL_2:.*]]: <>) -> (out0: <i32>, out1: <i32>) {
// CHECK:           %[[VAL_3:.*]], %[[VAL_4:.*]] = control_merge {{\[}}%[[VAL_0]], %[[VAL_1]]]  : [<i32>, <i32>] to <i32>, <i1>
// CHECK:           %[[VAL_5:.*]] = mux %[[VAL_4]] {{\[}}%[[VAL_0]], %[[VAL_1]]] : <i1>, [<i32>, <i32>] to <i32>
// CHECK:           end %[[VAL_3]], %[[VAL_5]] : <i32>, <i32>
// CHECK:         }
handshake.func @cmergeToMuxIndexOpt(%arg0: <i32>, %arg1: <i32>, %start: <>) -> (<i32>, <i32>) {
  %result, %index = control_merge [%arg0, %arg1] : [<i32>, <i32>] to <i32>, <i32>
  %mux = mux %index [%arg0, %arg1] : <i32>, [<i32>, <i32>] to <i32>
  end %result, %mux : <i32>, <i32>
}

