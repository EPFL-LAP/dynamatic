// CHECK:           %[[VAL_5]], %[[VAL_6:.*]] = cond_br %[[VAL_2]], %[[VAL_4]] : <i1>, <i8>
// CHECK:           %[[VAL_7:.*]] = extsi %[[VAL_6]] : <i8> to <i32>
// CHECK:           end %[[VAL_7]] : <i32>
// CHECK:         }
handshake.func @simpleCycle(%arg0: <i8>, %index: <i1>, %cond: <i1>, %start: <>) -> (<i32>) {
  %ext = extsi %arg0 : <i8> to <i32>
  %muxOut = mux %index [%ext, %true] : <i1>, [<i32>, <i32>] to <i32>
  %true, %false = cond_br %cond, %muxOut : <i1>, <i32>
  end %false : <i32>
}

