// CHECK-SAME:     %[[VAL_0:.*]]: <i8>, %[[VAL_1:.*]]: <i16>, %[[VAL_2:.*]]: <i24>, %[[VAL_3:.*]]: <i2>, %[[VAL_4:.*]]: <i1>, %[[VAL_5:.*]]: <i1>, %[[VAL_6:.*]]: <>) -> (out0: <i32>) {
