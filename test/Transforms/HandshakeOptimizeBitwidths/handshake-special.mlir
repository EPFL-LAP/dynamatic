// CHECK:           %[[VAL_8:.*]] = extsi %[[VAL_1]] {handshake.bb = 0 : ui32} : <i16> to <i24>
// CHECK:           %[[VAL_9:.*]] = mux %[[VAL_3]] {{\[}}%[[VAL_7]], %[[VAL_10:.*]], %[[VAL_11:.*]], %[[VAL_12:.*]]] : <i2>, [<i24>, <i24>, <i24>, <i24>] to <i24>
// CHECK:           %[[VAL_10]], %[[VAL_13:.*]] = cond_br %[[VAL_5]], %[[VAL_9]] : <i1>, <i24>
// CHECK:           %[[VAL_14:.*]] = mux %[[VAL_4]] {{\[}}%[[VAL_8]], %[[VAL_13]]] : <i1>, [<i24>, <i24>] to <i24>
// CHECK:           %[[VAL_11]], %[[VAL_15:.*]] = cond_br %[[VAL_5]], %[[VAL_14]] : <i1>, <i24>
// CHECK:           %[[VAL_16:.*]] = mux %[[VAL_4]] {{\[}}%[[VAL_2]], %[[VAL_15]]] : <i1>, [<i24>, <i24>] to <i24>
// CHECK:           %[[VAL_12]], %[[VAL_17:.*]] = cond_br %[[VAL_5]], %[[VAL_16]] : <i1>, <i24>
// CHECK:           %[[VAL_18:.*]] = extsi %[[VAL_17]] : <i24> to <i32>
// CHECK:           end %[[VAL_18]] : <i32>
// CHECK:         }
handshake.func @complexCycle(%arg0: <i8>, %arg1: <i16>, %arg2: <i24>, %bigIndex: <i2>, %index: <i1>, %cond: <i1>, %start: <>) -> (<i32>) {
  %ext0 = extsi %arg0 : <i8> to <i32>
  %ext1 = extsi %arg1 : <i16> to <i32>
  %ext2 = extsi %arg2 : <i24> to <i32>
  %mux0 = mux %bigIndex [%ext0, %condTrue0, %condTrue1, %condTrue2] : <i2>, [<i32>, <i32>, <i32>, <i32>] to <i32>
  %condTrue0, %condFalse0 = cond_br %cond, %mux0 : <i1>, <i32>
  %mux1 = mux %index [%ext1, %condFalse0] : <i1>, [<i32>, <i32>] to <i32>
  %condTrue1, %condFalse1 = cond_br %cond, %mux1 : <i1>, <i32>
  %mux2 = mux %index [%ext2, %condFalse1] : <i1>, [<i32>, <i32>] to <i32>
