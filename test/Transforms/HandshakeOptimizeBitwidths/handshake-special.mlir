// CHECK-SAME:     %[[ARG0:.*]]: memref<1000xi32>, %[[ARG1:.*]]: <>, %[[ARG2:.*]]: <>) -> (out0: <i32>, out1: <>) {
// CHECK:           %[[VAL_0:.*]], %[[VAL_1:.*]] = mem_controller{{\[}}%[[ARG0]] : memref<1000xi32>] start(%[[ARG1]]) groups(bb0 %[[VAL_2:.*]]: [store(%[[VAL_3:.*]], %[[VAL_4:.*]])]) lsq(%[[VAL_5:.*]], %[[VAL_6:.*]], %[[VAL_7:.*]]) end(%[[ARG2]]) : <i10>, <i32>, <i32>
